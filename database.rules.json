{
  "rules": {
    ".read": false,
    ".write": false,
    "zem_salons": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z2-9]{6}$/)",
        "joueurs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 'm', 'x', 'z']) && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('m').isString() && newData.child('m').val().length <= 40 && newData.child('x').isNumber() && newData.child('z').isNumber()"
          }
        },
        "messages": {
          "$m": {
            ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
            ".validate": "newData.hasChildren(['u', 'n', 'txt', 't']) && newData.child('txt').isString() && newData.child('txt').val().length >= 1 && newData.child('txt').val().length <= 140 && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('t').val() <= now"
          }
        }
      }
    },
    "zem_vies": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['nom', 'modele', 'depart', 'argent', 'faim', 'logement', 'cree', 't'])",
        "nom": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "modele": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "depart": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && (newData.val() === 'debrouillard' || newData.val() === 'fils'))"
        },
        "cree": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now)"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "argent": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && ((!data.exists() && ((newData.parent().child('depart').val() === 'fils' && newData.val() === 150000) || (newData.parent().child('depart').val() === 'debrouillard' && newData.val() === 2000))) || (data.exists() && (newData.val() <= data.val() || (newData.val() - data.val() <= 5000 && newData.parent().child('t').val() === now && now - data.parent().child('t').val() >= 3000))))"
        },
        "faim": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "logement": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "vehicule": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "metier": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "grade": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "dette": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loyerT": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$autre": {
          ".validate": false
        },
        "carburant": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "vehiculeFin": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "versement": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "journeeFin": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "garderobe": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "carrieres": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "courses": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "billet": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "vols": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1)"
        },
        "chapitres": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "commerces": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        }
      }
    },
    "zem_classement": {
      ".read": "auth != null",
      "$ligne": {
        ".indexOn": ["s", "t"],
        ".validate": "$ligne.matches(/^[a-z0-9-]{1,24}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 's', 't']) && (!data.exists() || newData.child('s').val() >= data.child('s').val())",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000" },
          "t": { ".validate": "newData.val() === now" },
          "$autre": { ".validate": false }
        }
      }
    },
    "zem_progres": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['d', 't']) && newData.child('d').isString() && newData.child('d').val().length <= 60000",
        "d": { ".validate": true },
        "t": { ".validate": "newData.val() === now" },
        "$autre": { ".validate": false }
      }
    },
    "zem_defi_departs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['t', 'j', 'l'])",
        "t": { ".validate": "newData.val() === now" },
        "j": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)" },
        "l": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
        "$autre": { ".validate": false }
      }
    },
    "zem_defi": {
      ".read": "auth != null",
      "$jour": {
        ".indexOn": ["s"],
        ".validate": "$jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['n', 's', 'c', 'p', 'a', 'tr', 'm', 'x', 'ma', 'd', 'km', 'dep', 't', 'l', 'ns', 'mi']) && root.child('zem_defi_departs').child($uid).child('t').val() === newData.child('dep').val() && root.child('zem_defi_departs').child($uid).child('j').val() === $jour && root.child('zem_defi_departs').child($uid).child('l').val() === newData.child('l').val() && newData.child('d').val() * 1000 <= now - newData.child('dep').val() + 5000 && newData.child('s').val() === newData.child('c').val() * 100 + newData.child('p').val() * 10 + newData.child('a').val() / 10 + newData.child('m').val() * 500 - newData.child('tr').val() * 50 && (!data.exists() || newData.child('s').val() > data.child('s').val() || (newData.child('s').val() === data.child('s').val() && newData.child('d').val() < data.child('d').val()))",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "av": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "z": { ".validate": "newData.isString() && newData.val().length <= 5" },
          "s": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000" },
          "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30 && newData.val() * 15 <= newData.parent().child('d').val()" },
          "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('d').val() * 2" },
          "a": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 10 === 0 && newData.val() <= newData.parent().child('c').val() * 1500 + newData.parent().child('p').val() * 25 + newData.parent().child('d').val() * 40 + 1000" },
          "tr": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "m": { ".validate": "newData.val() === 0 || newData.val() === 1" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "ma": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "d": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 7200" },
          "km": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('d').val() * 36" },
          "dep": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.val() === now" },
          "l": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "ns": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 60 && newData.parent().child('c').val() < newData.val()" },
          "mi": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$autre": { ".validate": false }
        }
      }
    },
    "zem_defi_traces": {
      ".read": "auth != null",
      "$jour": {
        ".validate": "$jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['k', 't']) && newData.parent().parent().parent().child('zem_defi').child($jour).child($uid).child('t').val() === now",
          "k": { ".validate": "newData.isString() && newData.val().length <= 40000" },
          "t": { ".validate": "newData.val() === now" },
          "$autre": { ".validate": false }
        }
      }
    },
    "zem_presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['ou', 't'])",
        "ou": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "t": { ".validate": "newData.isNumber()" },
        "$autre": { ".validate": false }
      }
    },
    "zem_stats": {
      ".read": "auth != null",
      "jours": {
        "$jour": {
          "$cle": {
            ".write": "auth != null && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && ($cle === 'vues' || $cle === 'visiteurs' || $cle === 'nouveaux' || $cle === 'salon' || $cle === 'zemrun')",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      }
    }
  }
}
