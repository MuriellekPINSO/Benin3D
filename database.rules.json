{
  "rules": {
    ".read": false,
    ".write": false,
    "zem_salons": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z2-9]{6}$/)",
        "joueurs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 'm', 'x', 'z']) && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('m').isString() && newData.child('m').val().length <= 40 && newData.child('x').isNumber() && newData.child('z').isNumber()"
          }
        },
        "messages": {
          "$m": {
            ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
            ".validate": "newData.hasChildren(['u', 'n', 'txt', 't']) && newData.child('txt').isString() && newData.child('txt').val().length >= 1 && newData.child('txt').val().length <= 140 && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('t').val() <= now"
          }
        }
      }
    },
    "zem_vies": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['nom', 'modele', 'depart', 'argent', 'faim', 'logement', 'cree', 't'])",
        "nom": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "modele": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "depart": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && (newData.val() === 'debrouillard' || newData.val() === 'fils'))"
        },
        "cree": {
          ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now)"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "argent": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && ((!data.exists() && ((newData.parent().child('depart').val() === 'fils' && newData.val() === 150000) || (newData.parent().child('depart').val() === 'debrouillard' && newData.val() === 2000))) || (data.exists() && (newData.val() <= data.val() || (newData.val() - data.val() <= 5000 && newData.parent().child('t').val() === now && now - data.parent().child('t').val() >= 3000))))"
        },
        "faim": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "logement": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "vehicule": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "metier": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "grade": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "dette": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loyerT": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$autre": {
          ".validate": false
        },
        "carburant": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "vehiculeFin": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "billet": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "vols": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1)"
        }
      }
    }
  }
}
